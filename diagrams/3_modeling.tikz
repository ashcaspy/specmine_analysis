\usetikzlibrary{arrows.meta,shapes.geometric}
\definecolor{navy}{HTML}{213A5B}
\definecolor{blue}{HTML}{3977A8}
\definecolor{teal}{HTML}{27826F}
\definecolor{orange}{HTML}{C56A36}
\definecolor{violet}{HTML}{7656A5}
\definecolor{paleBlue}{HTML}{EAF2F8}
\definecolor{paleTeal}{HTML}{E9F4F0}
\definecolor{paleOrange}{HTML}{FCF0E7}
\definecolor{paleViolet}{HTML}{F1ECF8}
\tikzset{
  data/.style={draw=blue!75!black,fill=paleBlue,rounded corners=1.5mm,
    line width=.9pt,align=center,text width=2.8cm,minimum height=.78cm,
    inner sep=4pt,font=\scriptsize},
  train/.style={draw=teal!80!black,fill=paleTeal,rounded corners=1.5mm,
    line width=.9pt,align=center,text width=2.45cm,minimum height=.72cm,
    inner sep=4pt,font=\scriptsize},
  model/.style={draw=orange!85!black,fill=paleOrange,rounded corners=1.5mm,
    line width=.9pt,align=center,text width=2.65cm,minimum height=.78cm,
    inner sep=4pt,font=\scriptsize},
  result/.style={draw=violet!80!black,fill=paleViolet,rounded corners=1.5mm,
    line width=1pt,align=center,text width=2.65cm,minimum height=.78cm,
    inner sep=4pt,font=\scriptsize},
  decision/.style={diamond,draw=teal!80!black,fill=paleTeal,line width=.9pt,
    aspect=2,align=center,inner sep=2pt,font=\scriptsize},
  laneA/.style={draw=blue!45,fill=blue!4,rounded corners=2mm,line width=.7pt},
  laneB/.style={draw=violet!45,fill=violet!4,rounded corners=2mm,line width=.7pt},
  prep/.style={draw=teal!35,fill=teal!3,rounded corners=2mm,line width=.7pt},
  flow/.style={-{Stealth[length=2mm]},draw=navy,line width=.85pt},
  trainflow/.style={flow,draw=teal!80!black},
  testflow/.style={flow,draw=violet!80!black},
  lab/.style={font=\tiny,fill=white,inner sep=1pt,text=navy,align=center},
  heading/.style={font=\bfseries\small,text=navy}
}
\begin{tikzpicture}[font=\sffamily]
  \node[prep,minimum width=815pt,minimum height=131.4517326pt] at (0.2,16.6) {};
\node[data,text width=148.0341736pt, minimum height=132.0207885pt, node font=\large] (numeric2) at (-11.38,16.59)
      {\textbf{Training Data Split}}; 
  \node[prep,minimum width=815pt,minimum height=131.4517326pt] at (0.2,11.31) {};
\node[train,text width=148.0341736pt, minimum height=132.0207885pt, node font=\large] (numeric2) at (-11.38,11.3)
      {\textbf{Input Feature \\Candidate Filtering}}; 
  \node[prep,minimum width=815pt,minimum height=131.4517326pt] at (0.2,6) {};
\node[result,text width=148.0341736pt, minimum height=132.0207885pt, node font=\large] (numeric2) at (-11.38,5.99)
      {\textbf{Model Training}}; 
  % Split by repository, not by specification, whenever multiple repositories exist.
  \node[data, minimum height=59pt] (input) at (-6.25,16.69)
    {\textbf{Modeling data}\\one row / spec\\repository ID + scores};
  \node[decision,text width=2.3cm] (split) at (-1.4,16.69)
    {\textbf{80 / 20 split}\\seed 625};
  \node[train,text width=2.85cm] (trainrepos) at (1.75,15.22)
    {\textbf{TRAIN\\ REPOSITORIES}\\80\% of groups};
  \node[result,text width=2.85cm] (testrepos) at (1.75,17.95)
    {\textbf{HELD-OUT REPOSITORIES}\\20\% of groups};
  \node[train,text width=2.65cm] (trainset) at (5.92,15.22)
    {\textbf{Training rows}\\observed score per fit};
  \node[result,text width=2.65cm] (testset) at (5.92,17.95)
    {\textbf{Test rows}\\observed scores only};
  \draw[flow] (input) -- (split);
  \draw[trainflow] (split.south) -- ++(0,-0.52) -- (trainrepos.west);
  \draw[testflow] (split.north) -- ++(0,0.36) -- (testrepos.west);
  \draw[trainflow] (trainrepos.east) -- (trainset.west);
  \draw[testflow] (testrepos.east) -- (testset.west);

  % Shared visual preparation recipe, executed independently for each score.
 \node[train,text width=2.65cm] (eligibility) at (9.5,15.22)
    {\textbf{Row eligibility}\\at least 100\\cap at 50,000};
  \node[decision,text width=2.35cm] (missing) at (-6.1,11.45)
    {\textbf{Input \\missingness\\$>80\%$?}};
  \node[train,text width=2.5cm] (numeric) at (-1.7,12.38)
    {\textbf{NUMERIC / BINARY}\\remove constants;\\median; impute;\\standardize};
  \node[train,text width=2.5cm] (categorical) at (-1.7,10.42)
    {\textbf{CATEGORICAL}\\$\leq60$ levels\\$\geq20$ rows / level};
  \node[train,text width=2.5cm] (numericcorr) at (4.95,12.38)
    {\textbf{Numeric \\redundancy}\\Spearman $|\rho|\geq.98$\\drop later candidate};
  \node[train,text width=2.5cm] (rare) at (1.55,10.35)
    {\textbf{Rare / unseen\\ levels}\\pool rare to OTHER;\\unseen to reference};
  \node[train,text width=2.5cm] (encoded) at (4.94,10.28)
    {\textbf{Encode categories}\\one-hot + standardize};
  \node[train,text width=2.75cm] (design) at (8.8,11.48)
    {\textbf{Design matrix}\\combine \\numeric + encoded\\drop duplicate \\columns\\$|r|\geq.999999$};
  \node[train,text width=2.5cm] (leakage) at (12.35,11.54)
    {\textbf{Score-rule guard}\\exclude inputs overlapping\\heuristic score logic};

  \draw[trainflow] (trainset.east) --(eligibility.west);
  \draw[trainflow] (eligibility.south) -- ++(0,-0.66) -- ++(-15.6,0) -- (missing.north);
  \draw[trainflow] (missing.east) -- (numeric.west);
  \draw[trainflow] (missing.east) --(categorical.west);
  \node[lab, node font=\scriptsize] at (-6.1,10.18) {drop if yes};
  \draw[trainflow] (numeric) -- (numericcorr);
  \draw[trainflow] (categorical) -- (rare);
  \draw[trainflow] (rare) -- (encoded);
  \draw[trainflow] (numericcorr.east) --  (design.west);
  \draw[trainflow] (encoded.east) -- (design.west);
  \draw[trainflow] (design) -- (leakage);

  % Two distinct score lanes; nothing is combined into a composite outcome.
  \node[data,text width=89.5597248pt] (complete) at (-6.7,7.35)
    {\texttt{target\_spec\_completeness}\\0--5};
  \node[model] (fitA) at (-3.47,6)
    {\textbf{Fit candidates}\\HC3 OLS + intercept-only};
  \node[decision,text width=2.25cm] (waldA) at (0.75,5.93)
    {\textbf{Joint Wald test}\\categorical terms};
  \node[model] (reduceA) at (4.85,5.93)
    {\textbf{Reduce / refit}\\drop least significant\\if $p>.05$};
  \node[result] (selectA) at (8.7,5.85)
    {\textbf{Select candidate}\\lowest held-out\\ RMSE\\tie: fewer predictors};
  \node[result] (evalA) at (12.53,5.78)
    {\textbf{Evaluate}\\RMSE, nRMSE, $R^2$\\clip prediction \\to [0,5]};

  \node[data,text width=89.5597235pt] (quality) at (-6.7,4.61)
    {\texttt{target\_spec\_quality}\\0--5};

  \draw[trainflow] (leakage.south) -- ++(0,-1.3) 
    -- (12.35,8) -- (-3.5,8) -- (fitA.north);
  \draw[trainflow, densely dashed] (reduceA.south) -- ++(0,-1.14)
       -- (-3.47,4.22) -- (fitA.south);
  \draw[trainflow] (complete) -- (fitA);
  \draw[trainflow] (fitA) -- (waldA);
  \draw[trainflow] (waldA) -- (reduceA);
  \draw[trainflow] (reduceA) -- (selectA);
  \draw[testflow] (selectA) -- (evalA);

  \draw[trainflow] (quality) -- (fitA);

  % Held-out outcomes are used for candidate comparison and test reporting.
  \draw[testflow] (testset.east) -- ++(1.0,0) -- (14,17.95)
    -- (14,7.39) -- (12.53,7.39) -- (evalA.north);








\end{tikzpicture}
